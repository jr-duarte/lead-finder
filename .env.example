# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/lead-finder

# Crawler tuning
CRAWLER_CONCURRENCY=2
CRAWLER_REQUEST_DELAY_MS=1200
CRAWLER_TIMEOUT_MS=15000
# Páginas de contato visitadas por site quando a home não traz e-mail (0 desativa)
CRAWLER_MAX_CONTACT_PAGES=2
CRAWLER_USER_AGENT=LeadFinder/1.0 (+local research tool)

# Data source for place collection.
# "mock"   -> deterministic local generator, no network, works offline (default)
# "osm"    -> OpenStreetMap Overpass API (public, no API key required)
# "google" -> Google Places API (New). Has rating/reviews; requires a billed key.
PLACES_SOURCE=google
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Google Places API (New) - required when PLACES_SOURCE=google.
# Create at https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_ENDPOINT=https://places.googleapis.com/v1/places:searchText

# Geração de abordagens com IA via Claude Code local (`claude -p`).
# Usa o login do Claude Code (seu plano), sem API key.
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_MS=180000

# Consulta do CNPJ encontrado no site na base da Receita (Minha Receita, sem chave).
# Deixe vazio para desativar.
CNPJ_LOOKUP_ENDPOINT=https://minhareceita.org

# Caixa de entrada do WhatsApp (Baileys, conexão direta, sem Docker).
# A sessão fica salva em WHATSAPP_SESSION_DIR/WHATSAPP_SESSION_NAME — nunca
# versione essa pasta: ela dá acesso à sua conta.
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_NAME=lead-finder
WHATSAPP_SESSION_DIR=.whatsapp-session
# Dias de histórico importados na primeira conexão.
WHATSAPP_INITIAL_SYNC_DAYS=7
# Sobreposição (minutos) com a sincronização anterior, para não perder mensagens.
WHATSAPP_SYNC_SAFETY_WINDOW_MIN=1440
WHATSAPP_INCLUDE_GROUPS=false

# Campanhas de prospecção pelo WhatsApp (primeiro contato com leads novos).
# Limite de primeiros contatos por dia, somando todas as campanhas. Comece baixo
# e suba aos poucos: muitos contatos novos de uma vez levam a bloqueio.
WHATSAPP_CAMPAIGN_DAILY_LIMIT=5
# Intervalo padrão entre envios (minutos) e a variação aplicada a ele (±%).
WHATSAPP_CAMPAIGN_DEFAULT_INTERVAL_MIN=10
WHATSAPP_CAMPAIGN_JITTER_PERCENT=30
